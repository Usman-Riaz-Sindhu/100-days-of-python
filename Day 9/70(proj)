from art import logo
import os

print(logo)

data = {}
game_retry = True

while game_retry:
    name = input("What is your name: ")
    bid = int(input("What is your bid $: "))
    data[name] = bid

    retry = input("Are there any other bidders? Type 'yes' or 'no': ").lower()

    if retry == "yes":
        os.system("cls" if os.name == "nt" else "clear")
        print(logo)
    elif retry == "no":
        game_retry = False
    else:
        print("Invalid input. Please type 'yes' or 'no'.")

highest_bid = 0
winner = ""

for name, bid in data.items():
    if bid > highest_bid:
        highest_bid = bid
        winner = name

print(f"The winner is {winner} with a bid of ${highest_bid}.")